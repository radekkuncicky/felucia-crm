  vytvoreno        DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId, vytvoreno])
  @@index([userId, vytvoreno])
  @@map("ai_usage_logs")
}
