model ZakazkaFoto {
  id          String    @id @default(cuid())
  zakazkaId   String
  url         String
  popis       String?
  nahralId    String
  vytvoreno   DateTime  @default(now())

  zakazka     Zakazka   @relation(fields: [zakazkaId], references: [id], onDelete: Cascade)
  nahral      User      @relation(fields: [nahralId], references: [id])

  @@map("zakazka_fotky")
}

model Vyuctovani {
