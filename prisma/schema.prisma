model ZakazkaPolozka {
  id              String              @id @default(cuid())
  zakazkaId       String
  nazev           String
  kod             String?
  mnozstvi        Decimal             @default(1)
  jednotka        String              @default("ks")
  prodejniCena    Decimal?
  nakupniCena     Decimal?
  dphSazba        Decimal             @default(12)
  mnozstviPouzito Decimal?
  stav            ZakazkaPolozkaStav  @default(CEKA)
