  vytvoreno   DateTime  @default(now())

  zakazka     Zakazka   @relation(fields: [zakazkaId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([zakazkaId])
  @@map("zakazka_komentare")
}

model Sod {
  id                String   @id @default(cuid())
  orgId             String
  dealId            String
  cislo             String

  typ               SodTyp

  // Klient
  klientJmeno       String
  klientAdresa      String?
  klientEmail       String?
  klientTelefon     String?
  klientIco         String?
  klientDic         String?

  // Kontaktní osoba
  kontaktniOsoba    String?
  kontaktniTelefon  String?

  // Dílo
  predmetDila       String
  adresaDila        String?

  // Termíny
  terminPrevzeti    String?
  pocetDniRealizace Int?
  zmenaTerm         String?

  // Cena
  cenaBezDph        Decimal? @db.Decimal(12, 2)
  cenaSDph          Decimal? @db.Decimal(12, 2)
  dphSazba          Decimal  @default(21) @db.Decimal(5, 2)

  // Záloha
  zalohaKc          Decimal? @db.Decimal(12, 2)
  zalohaSplatnost   Int?     @default(14)
  zalohaKategorie   String?

  // Vygenerovaný text smlouvy (editovatelný, zdroj pro PDF)
  textSmlouvy       String?
  templateId        String?

  // Prilohy PDF
  prilohaVop        Boolean  @default(false)
  prilohaVzsp       Boolean  @default(false)
  prilohaCenik      Boolean  @default(false)
  prilohaNabidka    Boolean  @default(false)

  // Metadata
  poznamky          String?
  vytvoreno         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  deal         Deal              @relation(fields: [dealId], references: [id])
  template     ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([orgId, cislo])
  @@map("sod")
}

model Document {
  id           String   @id @default(cuid())
  orgId        String
  nazev        String
  originalName String
  velikost     BigInt
  mimeType     String
  cesta        String
  popis        String?
  uploadedById String
  vytvoreno    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([orgId])
  @@map("documents")
}

model Lead {
  id                   String     @id @default(cuid())
  orgId                String
  jmeno                String
  email                String?
  telefon              String?
  firma                String?
  zdroj                LeadZdroj  @default(RUCNE)
  status               LeadStatus @default(NOVY)
  zprava               String?
  assignedToId         String?
  odhadovanaHodnota    Decimal?   @db.Decimal(12, 2)
  tagy                 String[]   @default([])
  duvodZruseni         String?
  prevedenNaOpId       String?    @unique
  prevedenNaKlientId   String?
  apiKeyId             String?
  vytvoreno            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization       Organization @relation(fields: [orgId], references: [id])
  assignedTo         User?        @relation("LeadAssigned", fields: [assignedToId], references: [id])
  prevedenNaOp       Deal?        @relation(fields: [prevedenNaOpId], references: [id])
