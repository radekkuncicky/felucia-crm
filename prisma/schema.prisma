  klientPritomen  Boolean       @default(true)
  poznamka        String?
  odmitnutoDuvod     String?
  upravenoPodpisano  Boolean   @default(false)
  schvalenoId        String?
  etapaId         String?
  vytvoreno       DateTime      @default(now())
  podpisano       DateTime?
  schvaleno       DateTime?
