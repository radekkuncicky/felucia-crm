  organization    Organization  @relation(fields: [orgId], references: [id])
  zakazka         Zakazka       @relation(fields: [zakazkaId], references: [id])
  technik         User          @relation("PredavakTechnik", fields: [technikId], references: [id])
  schvalil        User?         @relation("PredavakSchvalil", fields: [schvalenoId], references: [id])
  etapa           ZakazkaEtapa? @relation(fields: [etapaId], references: [id])
