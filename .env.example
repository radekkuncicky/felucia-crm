# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nanto_crm"

# NextAuth
NEXTAUTH_URL="https://crm.nanto.cz"
NEXTAUTH_SECRET=""   # generate: openssl rand -base64 48

# Webhook
WEBHOOK_SECRET=""    # generate: openssl rand -hex 32

# SMTP (for password reset and magic link emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NANTO CRM <noreply@nanto.cz>"

# Anthropic AI
ANTHROPIC_API_KEY=""

# Sentry (error tracking) — bez DSN je Sentry vypnuté
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""   # jen pro upload source map při buildu (volitelné)

# Root domain
NEXT_PUBLIC_ROOT_DOMAIN=felucia.io

# Mobile app CORS (restrict after Expo app release)
ALLOWED_ORIGINS=https://felucia.io

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_STANDARD_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...

# Seed demo účtů pro Apple App Review (scripts/seed-apple-review.ts)
SEED_ADMIN_PASSWORD=
SEED_TECHNIK_PASSWORD=

# ── RLS (Row Level Security) — orgPrisma se připojuje jako tato role (viz CLAUDE.md)
RLS_DB_USER=nanto_app
RLS_DB_PASSWORD=

# ── Šifrování tenant tajemství (SMTP hesla, tokeny) — 32 B hex: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# ── SMS (OTP podpis smluv): SMS_PROVIDER=smsmanager|gosms|smsbrana
SMS_PROVIDER=smsmanager
SMSMANAGER_APIKEY=
GOSMS_CLIENT_ID=
GOSMS_CLIENT_SECRET=
GOSMS_CHANNEL=
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=

# ── Stripe: modul online podpisu
STRIPE_PODPISY_PRICE_ID=

# ── Ostatní
FELUCIA_TECH_APP_URL=
MAINTENANCE_MODE=false
